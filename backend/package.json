    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
